# Database
DATABASE_URL=postgresql://caseforge:caseforge@localhost:5432/caseforge

# Auth.js / NextAuth v5
AUTH_SECRET=generate-a-secure-random-string
NEXTAUTH_SECRET=generate-a-secure-random-string
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OpenAI
OPENAI_API_KEY=

# S3-compatible storage (AWS S3, MinIO, Cloudflare R2)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=caseforge
S3_FORCE_PATH_STYLE=true

# MinIO local dev: docker run -p 9000:9000 -p 9001:9001 minio/minio server /data --console-address ":9001"

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=CaseForge <noreply@caseforge.web.app>

# Public API (v1 stubs)
CASEFORGE_API_KEY=dev-api-key-change-me
