{
  "hosting": [
    {
      "target": "caseforge",
      "source": ".",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**",
        ".git/**",
        "docs/**",
        "tests/**"
      ],
      "frameworksBackend": {
        "region": "us-central1",
        "memory": "1GiB",
        "timeoutSeconds": 60
      }
    }
  ]
}
