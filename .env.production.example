# Production env for Firebase Hosting / Cloud Functions (andventure-map / caseforge)
# Do NOT put localhost here — it gets bundled into the SSR function.
# Copy to .env.production and fill in real values (gitignored).

AUTH_SECRET=replace-with-a-long-random-string
NEXTAUTH_URL=https://caseforge.web.app
AUTH_URL=https://caseforge.web.app

# REQUIRED: hosted Postgres URL (Neon, Supabase, Cloud SQL, etc.)
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/caseforge?sslmode=require
